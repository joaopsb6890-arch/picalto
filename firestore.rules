rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* Perfis de utilizador: leitura para todos os autenticados; escrita só pelo dono */
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    /* Publicações: leitura para autenticados; criação/apagamento só pelo autor;
       update só para gostos (campo likes) — qualquer autenticado */
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // só se pode alterar o campo likes (gostos), com o UID do autor inalterável.
      // O utilizador só pode adicionar/remover o PRÓPRIO uid ao array likes,
      // sem duplicados e sem tocar nos gostos de outras pessoas.
      allow update: if request.auth != null
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.imageUrl == resource.data.imageUrl
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is list
        && (
          // adição: conjunto antigo ⊆ novo, diferença = apenas o próprio uid (1x)
          // sem duplicados (set.size == list.size)
          (resource.data.likes.toSet().difference(request.resource.data.likes.toSet()).size() == 0
            && request.resource.data.likes.toSet().difference(resource.data.likes.toSet()).size() == 1
            && request.auth.uid in request.resource.data.likes.toSet().difference(resource.data.likes.toSet())
            && request.resource.data.likes.toSet().size() == request.resource.data.likes.size())
          // remoção: conjunto novo ⊆ antigo, diferença = apenas o próprio uid
          // sem duplicados (set.size == list.size) — bloqueia trocar por repetido
          || (request.resource.data.likes.toSet().difference(resource.data.likes.toSet()).size() == 0
            && resource.data.likes.toSet().difference(request.resource.data.likes.toSet()).size() == 1
            && request.auth.uid in resource.data.likes.toSet().difference(request.resource.data.likes.toSet())
            && resource.data.likes.toSet().size() == resource.data.likes.size())
          // alteração neutra (reescrita idêntica)
          || (request.resource.data.likes == resource.data.likes
            || (request.resource.data.likes.toSet() == resource.data.likes.toSet()
              && request.resource.data.likes.toSet().size() == request.resource.data.likes.size()
              && resource.data.likes.toSet().size() == resource.data.likes.size()))
        );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      /* comentários: leitura para autenticados; criação só com o próprio uid */
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow update: if false; // comentários não são editáveis
      }
    }

    /* Seguir: leitura para autenticados; criação/apagamento só pelo próprio */
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.follower == request.auth.uid;
      allow delete: if request.auth != null && resource.data.follower == request.auth.uid;
      allow update: if false;
    }

    /* Conversas: leitura só para participantes; criação por qualquer autenticado;
       edição negada (mensagens são subdocumentos) */
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update, delete: if false;

      /* mensagens: leitura/escrita só para participantes */
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false; // mensagens não são editáveis nem apagáveis
      }
    }

    /* Histórias (stories): leitura para autenticados; criação só com o próprio uid */
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    /* Favoritos: leitura apenas pelo dono; criação/apagamento pelo dono */
    match /favorites/{favId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    /* Progresso / XP / conquistas: leitura para autenticados (ranking);
       escrita só pelo dono, campos validados. Best_* por jogo permitido e validado. */
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.achievements is list
        && request.resource.data.keys().hasOnly(
          ['uid','xp','level','achievements','lastActive','best_memory','best_snake','best_flappy','best_g2048','best_tictactoe','best_typing']
        )
        && (!('best_memory' in request.resource.data) || (request.resource.data.best_memory is number && request.resource.data.best_memory >= 0))
        && (!('best_snake' in request.resource.data) || (request.resource.data.best_snake is number && request.resource.data.best_snake >= 0))
        && (!('best_flappy' in request.resource.data) || (request.resource.data.best_flappy is number && request.resource.data.best_flappy >= 0))
        && (!('best_g2048' in request.resource.data) || (request.resource.data.best_g2048 is number && request.resource.data.best_g2048 >= 0))
        && (!('best_tictactoe' in request.resource.data) || (request.resource.data.best_tictactoe is number && request.resource.data.best_tictactoe >= 0))
        && (!('best_typing' in request.resource.data) || (request.resource.data.best_typing is number && request.resource.data.best_typing >= 0));
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['xp','level','achievements','lastActive','best_memory','best_snake','best_flappy','best_g2048','best_tictactoe','best_typing']
        )
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0
        && request.resource.data.level is number
        && request.resource.data.level >= 1
        && request.resource.data.achievements is list
        && (!('best_memory' in request.resource.data) || (request.resource.data.best_memory is number && request.resource.data.best_memory >= 0))
        && (!('best_snake' in request.resource.data) || (request.resource.data.best_snake is number && request.resource.data.best_snake >= 0))
        && (!('best_flappy' in request.resource.data) || (request.resource.data.best_flappy is number && request.resource.data.best_flappy >= 0))
        && (!('best_g2048' in request.resource.data) || (request.resource.data.best_g2048 is number && request.resource.data.best_g2048 >= 0))
        && (!('best_tictactoe' in request.resource.data) || (request.resource.data.best_tictactoe is number && request.resource.data.best_tictactoe >= 0))
        && (!('best_typing' in request.resource.data) || (request.resource.data.best_typing is number && request.resource.data.best_typing >= 0));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    /* Pontuações dos jogos: leitura para autenticados (leaderboard);
       criação só com o próprio uid, jogo válido e pontuação numérica */
    match /gameScores/{scoreId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.game is string
        && request.resource.data.game in ['memory','snake','flappy','g2048','tictactoe','typing'];
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false; // pontuações não são editáveis
    }

    /* Sondagens: leitura para autenticados; criação pelo autor.
       Votos em subcoleção polls/{pollId}/votes/{uid} — só o próprio uid, atómico. */
    match /polls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false; // opções não são editáveis (evita alterar votos alheios)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /votes/{voterUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == voterUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.optionIdx is int
          && request.resource.data.optionIdx >= 0
          && request.resource.data.optionIdx < get(/databases/$(database)/documents/polls/$(pollId)).data.options.size();
        allow update: if request.auth != null && request.auth.uid == voterUid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optionIdx'])
          && request.resource.data.optionIdx is int
          && request.resource.data.optionIdx >= 0
          && request.resource.data.optionIdx < get(/databases/$(database)/documents/polls/$(pollId)).data.options.size();
        allow delete: if false;
      }
    }

    /* Música partilhada: leitura para autenticados; criação pelo autor */
    match /songs/{songId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    /* tudo o resto: negado */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
